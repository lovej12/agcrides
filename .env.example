# --- Supabase (never commit real values) ---
NEXT_PUBLIC_SUPABASE_URL=https://xyzcompany.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=paste-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=paste-service-role-only-on-server-never-expose


# --- Ingestion ---
# Comma-separated SHA-256 hashes of device tokens (server compares hash, never raw)
# Generate with: echo -n "your-token" | shasum -a 256
DEVICE_TOKEN_HASHES=
INGEST_MAX_BATCH=50
INGEST_RATE_LIMIT_PER_MIN=60

# --- Demo mode (admin) ---
DEMO_MODE=false
DEMO_SPEED=6

# --- Map tiles (open, no key needed for Carto) ---
NEXT_PUBLIC_MAP_STYLE=https://basemaps.cartocdn.com/gl/positron-gl-style/style.json

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
